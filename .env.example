# PolySight Environment Configuration
# 이 파일을 .env로 복사하고 값을 입력하세요
# 또는 Settings 탭에서 UI로 설정할 수도 있습니다

# ============================================
# Elasticsearch (필수)
# ============================================
ELASTIC_CLOUD_SERVERLESS_URL=https://your-deployment.es.region.aws.elastic.cloud
ELASTIC_API_KEY=your-api-key-here

# ============================================
# Jina V4 설정 (선택)
# ============================================
# API Key를 입력하면 API 모드로 동작 (GPU 불필요)
# 비워두면 로컬 모드로 동작 (GPU 권장)
JINA_API_KEY=

# ============================================
# Anthropic API 설정 (Agent Arena용, 선택)
# ============================================
# Agent Arena 탭에서 LLM 기반 에이전트 사용 시 필요
ANTHROPIC_API_KEY=

# ============================================
# HuggingFace 설정 (선택)
# ============================================
# 로컬 모드에서 모델 다운로드 시 필요할 수 있음
HF_TOKEN=

# ============================================
# GPU VM 설정 메모 (설정값 아님, 참고용)
# ============================================
# GPU VM: polysight-gpu (GCP g2-standard-8, NVIDIA L4, us-west1)
# 외부 IP: VM 시작 시마다 변경될 수 있음 (Static IP 미사용)
# Gradio 접속: http://<외부IP>:7860
# SSH: gcloud compute ssh polysight-gpu --zone=us-west1-a
# 상세 셋업: GPU_SERVER_SETUP.md 참조
